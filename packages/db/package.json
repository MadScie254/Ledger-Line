{
  "name": "@ledgerline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma validate --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@ledgerline/db migration tests are pending\"",
    "db:check-drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.1",
    "@prisma/client": "^6.19.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
