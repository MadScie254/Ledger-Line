generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Organization {
  id                   String              @id @default(cuid())
  name                 String
  legalName            String?
  kraPin               String?
  taxId                String?
  industry             String?
  fiscalYearStartMonth Int                 @default(1)
  baseCurrency         String              @default("KES")
  address              Json?
  logoUrl              String?
  planTier             OrgPlanTier         @default(FREE)
  createdAt            DateTime            @default(now())
  accounts             Account[]
  accountingPeriods    AccountingPeriod[]
  attachments          Attachment[]
  auditLogEntries      AuditLogEntry[]
  bankConnections      BankConnection[]
  bankRules            BankRule[]
  bills                Bill[]
  billPayments         BillPayment[]
  budgets              Budget[]
  customers            Customer[]
  employees            Employee[]
  estimates            Estimate[]
  exchangeRates        ExchangeRate[]
  expenses             Expense[]
  importBatches        ImportBatch[]
  integrations         Integration[]
  invoices             Invoice[]
  journalEntries       JournalEntry[]
  notifications        Notification[]
  memberships          OrgMembership[]
  payRuns              PayRun[]
  paymentsReceived     PaymentReceived[]
  products             Product[]
  projects             Project[]
  purchaseOrders       PurchaseOrder[]
  recurringTemplates   RecurringTemplate[]
  roles                Role[]
  salesOrders          SalesOrder[]
  salesReceipts        SalesReceipt[]
  savedReports         SavedReport[]
  taxRates             TaxRate[]
  taxReturns           TaxReturn[]
  timeEntries          TimeEntry[]
  users                User[]
  vendors              Vendor[]
  workspaceRecords     WorkspaceRecord[]
}

model User {
  id                      String             @id @default(cuid())
  orgId                   String?
  name                    String
  email                   String             @unique
  phone                   String?
  mfaEnabled              Boolean            @default(false)
  avatarUrl               String?
  createdAt               DateTime           @default(now())
  closedPeriods           AccountingPeriod[] @relation("PeriodClosedBy")
  uploadedAttachments     Attachment[]       @relation("AttachmentUploadedBy")
  auditLogEntries         AuditLogEntry[]
  importedBatches         ImportBatch[]      @relation("ImportBatchImportedBy")
  createdJournalEntries   JournalEntry[]     @relation("JournalEntryCreatedBy")
  notifications           Notification[]
  memberships             OrgMembership[]
  timeEntries             TimeEntry[]
  org                     Organization?      @relation(fields: [orgId], references: [id])
  createdWorkspaceRecords WorkspaceRecord[]  @relation("WorkspaceRecordCreatedBy")
}

model OrgMembership {
  userId String
  orgId  String
  roleId String
  status MembershipStatus @default(INVITED)
  org    Organization     @relation(fields: [orgId], references: [id])
  role   Role             @relation(fields: [roleId], references: [id])
  user   User             @relation(fields: [userId], references: [id])

  @@id([userId, orgId])
  @@index([orgId])
  @@index([roleId])
}

model Role {
  id           String          @id @default(cuid())
  orgId        String
  name         String
  isSystemRole Boolean         @default(false)
  permissions  Json
  memberships  OrgMembership[]
  org          Organization    @relation(fields: [orgId], references: [id])

  @@unique([orgId, name])
}

model Account {
  id                  String            @id @default(cuid())
  orgId               String
  code                String
  name                String
  type                AccountType
  subtype             String?
  parentId            String?
  currency            String            @default("KES")
  isActive            Boolean           @default(true)
  openingBalance      Decimal           @default(0) @db.Decimal(18, 2)
  openingBalanceDate  DateTime?
  org                 Organization      @relation(fields: [orgId], references: [id])
  parent              Account?          @relation("AccountHierarchy", fields: [parentId], references: [id])
  children            Account[]         @relation("AccountHierarchy")
  billLines           BillLine[]
  BillPayment         BillPayment[]
  budgets             Budget[]
  categorizedExpenses Expense[]         @relation("ExpenseCategoryAccount")
  paidExpenses        Expense[]         @relation("ExpensePaymentAccount")
  lines               JournalLine[]
  PaymentReceived     PaymentReceived[]
  expenseProducts     Product[]         @relation("ProductExpenseAccount")
  incomeProducts      Product[]         @relation("ProductIncomeAccount")

  @@unique([orgId, code])
  @@index([orgId, type])
}

model JournalEntry {
  id                 String            @id @default(cuid())
  orgId              String
  entryDate          DateTime
  memo               String?
  sourceType         JournalSourceType
  sourceId           String?
  referenceNo        String?
  createdBy          String
  postedAt           DateTime          @default(now())
  isReversalOf       String?
  accountingPeriodId String?
  bankMatches        BankTransaction[]
  accountingPeriod   AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id])
  createdByUser      User              @relation("JournalEntryCreatedBy", fields: [createdBy], references: [id])
  org                Organization      @relation(fields: [orgId], references: [id])
  lines              JournalLine[]

  @@index([orgId, entryDate])
  @@index([orgId, sourceType, sourceId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  description    String?
  entityType     String?
  entityId       String?
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([entityType, entityId])
}

model AccountingPeriod {
  id             String                 @id @default(cuid())
  orgId          String
  startDate      DateTime
  endDate        DateTime
  status         AccountingPeriodStatus @default(OPEN)
  closedBy       String?
  closedAt       DateTime?
  closedByUser   User?                  @relation("PeriodClosedBy", fields: [closedBy], references: [id])
  org            Organization           @relation(fields: [orgId], references: [id])
  journalEntries JournalEntry[]

  @@unique([orgId, startDate, endDate])
}

model BankConnection {
  id              String            @id @default(cuid())
  orgId           String
  institutionName String
  accountNoMasked String
  currency        String            @default("KES")
  provider        String
  lastSyncedAt    DateTime?
  currentBalance  Decimal           @default(0) @db.Decimal(18, 2)
  org             Organization      @relation(fields: [orgId], references: [id])
  transactions    BankTransaction[]

  @@index([orgId])
}

model BankTransaction {
  id                    String                @id @default(cuid())
  bankConnectionId      String
  date                  DateTime
  description           String
  amount                Decimal               @db.Decimal(18, 2)
  direction             MoneyDirection
  status                BankTransactionStatus @default(UNREVIEWED)
  matchedJournalEntryId String?
  aiSuggestedCategory   String?
  bankConnection        BankConnection        @relation(fields: [bankConnectionId], references: [id])
  matchedJournalEntry   JournalEntry?         @relation(fields: [matchedJournalEntryId], references: [id])

  @@index([bankConnectionId, date])
  @@index([matchedJournalEntryId])
}

model BankRule {
  id              String       @id @default(cuid())
  orgId           String
  matchConditions Json
  actions         Json
  priority        Int          @default(100)
  org             Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, priority])
}

model Customer {
  id              String            @id @default(cuid())
  orgId           String
  displayName     String
  companyName     String?
  emails          String[]          @default([])
  phones          String[]          @default([])
  billingAddress  Json?
  shippingAddress Json?
  paymentTerms    String?
  currency        String            @default("KES")
  balance         Decimal           @default(0) @db.Decimal(18, 2)
  creditLimit     Decimal?          @db.Decimal(18, 2)
  tags            String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  billLines       BillLine[]
  org             Organization      @relation(fields: [orgId], references: [id])
  estimates       Estimate[]
  expenses        Expense[]
  invoices        Invoice[]
  payments        PaymentReceived[]
  projects        Project[]
  salesOrders     SalesOrder[]
  salesReceipts   SalesReceipt[]

  @@index([orgId, displayName])
}

model Product {
  id               String         @id @default(cuid())
  orgId            String
  name             String
  sku              String?
  type             ProductType
  salesPrice       Decimal        @default(0) @db.Decimal(18, 2)
  cost             Decimal        @default(0) @db.Decimal(18, 2)
  incomeAccountId  String?
  expenseAccountId String?
  qtyOnHand        Decimal        @default(0) @db.Decimal(18, 4)
  reorderPoint     Decimal?       @db.Decimal(18, 4)
  taxRateId        String?
  billLines        BillLine[]
  estimateLines    EstimateLine[]
  invoiceLines     InvoiceLine[]
  expenseAccount   Account?       @relation("ProductExpenseAccount", fields: [expenseAccountId], references: [id])
  incomeAccount    Account?       @relation("ProductIncomeAccount", fields: [incomeAccountId], references: [id])
  org              Organization   @relation(fields: [orgId], references: [id])
  taxRate          TaxRate?       @relation(fields: [taxRateId], references: [id])

  @@unique([orgId, sku])
  @@index([orgId, type])
}

model Invoice {
  id                  String                      @id @default(cuid())
  orgId               String
  customerId          String
  invoiceNo           String
  issueDate           DateTime
  dueDate             DateTime
  terms               String?
  status              InvoiceStatus               @default(DRAFT)
  subtotal            Decimal                     @default(0) @db.Decimal(18, 2)
  taxTotal            Decimal                     @default(0) @db.Decimal(18, 2)
  discountTotal       Decimal                     @default(0) @db.Decimal(18, 2)
  total               Decimal                     @default(0) @db.Decimal(18, 2)
  amountPaid          Decimal                     @default(0) @db.Decimal(18, 2)
  balanceDue          Decimal                     @default(0) @db.Decimal(18, 2)
  currency            String                      @default("KES")
  fxRate              Decimal                     @default(1) @db.Decimal(18, 8)
  message             String?
  footer              String?
  recurringTemplateId String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @default(now()) @updatedAt
  customer            Customer                    @relation(fields: [customerId], references: [id])
  org                 Organization                @relation(fields: [orgId], references: [id])
  lines               InvoiceLine[]
  payments            PaymentReceived[]
  paymentAllocations  PaymentReceivedAllocation[]

  @@unique([orgId, invoiceNo])
  @@index([orgId, status, dueDate])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  qty         Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  taxRateId   String?
  amount      Decimal  @default(0) @db.Decimal(18, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
}

model Estimate {
  id            String         @id @default(cuid())
  orgId         String
  customerId    String
  estimateNo    String
  issueDate     DateTime
  expiryDate    DateTime?
  status        EstimateStatus @default(DRAFT)
  subtotal      Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal        @default(0) @db.Decimal(18, 2)
  total         Decimal        @default(0) @db.Decimal(18, 2)
  currency      String         @default("KES")
  fxRate        Decimal        @default(1) @db.Decimal(18, 8)
  message       String?
  footer        String?
  convertedToId String?
  customer      Customer       @relation(fields: [customerId], references: [id])
  org           Organization   @relation(fields: [orgId], references: [id])
  lines         EstimateLine[]

  @@unique([orgId, estimateNo])
}

model EstimateLine {
  id          String   @id @default(cuid())
  estimateId  String
  productId   String?
  description String
  qty         Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  taxRateId   String?
  amount      Decimal  @default(0) @db.Decimal(18, 2)
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
}

model SalesReceipt {
  id               String       @id @default(cuid())
  orgId            String
  customerId       String?
  date             DateTime
  lines            Json
  paymentMethod    String
  depositAccountId String
  customer         Customer?    @relation(fields: [customerId], references: [id])
  org              Organization @relation(fields: [orgId], references: [id])
}

model SalesOrder {
  id                String       @id @default(cuid())
  orgId             String
  customerId        String?
  lines             Json
  status            String
  fulfillmentStatus String?
  customer          Customer?    @relation(fields: [customerId], references: [id])
  org               Organization @relation(fields: [orgId], references: [id])
}

model PaymentReceived {
  id               String                      @id @default(cuid())
  orgId            String
  customerId       String
  invoiceId        String?
  amount           Decimal                     @db.Decimal(18, 2)
  date             DateTime
  method           String
  depositAccountId String
  reference        String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @default(now()) @updatedAt
  customer         Customer                    @relation(fields: [customerId], references: [id])
  Account          Account                     @relation(fields: [depositAccountId], references: [id])
  invoice          Invoice?                    @relation(fields: [invoiceId], references: [id])
  org              Organization                @relation(fields: [orgId], references: [id])
  allocations      PaymentReceivedAllocation[]

  @@index([orgId, date])
}

model PaymentReceivedAllocation {
  id                String          @id @default(cuid())
  paymentReceivedId String
  invoiceId         String
  amount            Decimal         @db.Decimal(18, 2)
  invoice           Invoice         @relation(fields: [invoiceId], references: [id])
  paymentReceived   PaymentReceived @relation(fields: [paymentReceivedId], references: [id], onDelete: Cascade)
}

model RecurringTemplate {
  id           String       @id @default(cuid())
  orgId        String
  sourceType   String
  scheduleCron String
  startDate    DateTime
  endDate      DateTime?
  occurrences  Int?
  nextRunAt    DateTime
  autoSend     Boolean      @default(false)
  org          Organization @relation(fields: [orgId], references: [id])
}

model Vendor {
  id             String          @id @default(cuid())
  orgId          String
  displayName    String
  emails         String[]        @default([])
  phones         String[]        @default([])
  address        Json?
  taxId          String?
  paymentTerms   String?
  balance        Decimal         @default(0) @db.Decimal(18, 2)
  category       String?
  currency       String          @default("KES")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  bills          Bill[]
  purchaseOrders PurchaseOrder[]
  org            Organization    @relation(fields: [orgId], references: [id])

  @@index([orgId, displayName])
}

model Bill {
  id                 String                  @id @default(cuid())
  orgId              String
  vendorId           String
  billNo             String
  billDate           DateTime
  dueDate            DateTime
  status             BillStatus              @default(OPEN)
  subtotal           Decimal                 @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal                 @default(0) @db.Decimal(18, 2)
  total              Decimal                 @default(0) @db.Decimal(18, 2)
  amountPaid         Decimal                 @default(0) @db.Decimal(18, 2)
  currency           String                  @default("KES")
  fxRate             Decimal                 @default(1) @db.Decimal(18, 8)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @default(now()) @updatedAt
  org                Organization            @relation(fields: [orgId], references: [id])
  vendor             Vendor                  @relation(fields: [vendorId], references: [id])
  lines              BillLine[]
  payments           BillPayment[]
  paymentAllocations BillPaymentAllocation[]

  @@unique([orgId, billNo])
  @@index([orgId, status, dueDate])
}

model BillLine {
  id          String    @id @default(cuid())
  billId      String
  accountId   String?
  productId   String?
  description String
  qty         Decimal   @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal   @default(0) @db.Decimal(18, 2)
  taxRateId   String?
  amount      Decimal   @default(0) @db.Decimal(18, 2)
  isBillable  Boolean   @default(false)
  customerId  String?
  account     Account?  @relation(fields: [accountId], references: [id])
  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
  taxRate     TaxRate?  @relation(fields: [taxRateId], references: [id])
}

model Expense {
  id                String       @id @default(cuid())
  orgId             String
  payee             String
  date              DateTime
  paymentAccountId  String
  categoryAccountId String
  amount            Decimal      @db.Decimal(18, 2)
  taxRateId         String?
  isBillable        Boolean      @default(false)
  customerId        String?
  receiptUrl        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  categoryAccount   Account      @relation("ExpenseCategoryAccount", fields: [categoryAccountId], references: [id])
  customer          Customer?    @relation(fields: [customerId], references: [id])
  org               Organization @relation(fields: [orgId], references: [id])
  paymentAccount    Account      @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id])
  taxRate           TaxRate?     @relation(fields: [taxRateId], references: [id])

  @@index([orgId, date])
}

model PurchaseOrder {
  id       String       @id @default(cuid())
  orgId    String
  vendorId String
  lines    Json
  status   String
  org      Organization @relation(fields: [orgId], references: [id])
  vendor   Vendor       @relation(fields: [vendorId], references: [id])
}

model BillPayment {
  id               String                  @id @default(cuid())
  orgId            String
  date             DateTime
  paymentAccountId String
  method           String
  reference        String?
  billId           String?
  amount           Decimal                 @db.Decimal(18, 2)
  bill             Bill?                   @relation(fields: [billId], references: [id])
  org              Organization            @relation(fields: [orgId], references: [id])
  Account          Account                 @relation(fields: [paymentAccountId], references: [id])
  allocations      BillPaymentAllocation[]
}

model BillPaymentAllocation {
  id            String      @id @default(cuid())
  billPaymentId String
  billId        String
  amount        Decimal     @db.Decimal(18, 2)
  bill          Bill        @relation(fields: [billId], references: [id])
  billPayment   BillPayment @relation(fields: [billPaymentId], references: [id], onDelete: Cascade)
}

model TaxRate {
  id            String         @id @default(cuid())
  orgId         String
  name          String
  ratePct       Decimal        @db.Decimal(8, 4)
  type          TaxRateType
  jurisdiction  String
  kraCode       String?
  effectiveFrom DateTime
  billLines     BillLine[]
  estimateLines EstimateLine[]
  expenses      Expense[]
  invoiceLines  InvoiceLine[]
  products      Product[]
  org           Organization   @relation(fields: [orgId], references: [id])

  @@index([orgId, jurisdiction])
}

model TaxReturn {
  id           String          @id @default(cuid())
  orgId        String
  periodStart  DateTime
  periodEnd    DateTime
  type         TaxReturnType
  status       TaxReturnStatus @default(DRAFT)
  totalDue     Decimal         @default(0) @db.Decimal(18, 2)
  submittedRef String?
  filedAt      DateTime?
  org          Organization    @relation(fields: [orgId], references: [id])

  @@unique([orgId, type, periodStart, periodEnd])
}

model Employee {
  id              String         @id @default(cuid())
  orgId           String
  name            String
  nationalId      String?
  kraPin          String?
  nssfNo          String?
  shifNo          String?
  bankDetails     Json?
  salaryStructure Json
  payFrequency    String
  status          EmployeeStatus @default(ACTIVE)
  org             Organization   @relation(fields: [orgId], references: [id])
  payslips        Payslip[]

  @@index([orgId, name])
}

model PayRun {
  id          String       @id @default(cuid())
  orgId       String
  periodStart DateTime
  periodEnd   DateTime
  status      PayRunStatus @default(DRAFT)
  totals      Json
  org         Organization @relation(fields: [orgId], references: [id])
  payslips    Payslip[]

  @@index([orgId, periodStart, periodEnd])
}

model Payslip {
  id         String   @id @default(cuid())
  payRunId   String
  employeeId String
  earnings   Json
  deductions Json
  netPay     Decimal  @db.Decimal(18, 2)
  pdfUrl     String?
  employee   Employee @relation(fields: [employeeId], references: [id])
  payRun     PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
}

model Project {
  id           String        @id @default(cuid())
  orgId        String
  customerId   String?
  name         String
  budgetAmount Decimal?      @db.Decimal(18, 2)
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime?
  endDate      DateTime?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  org          Organization  @relation(fields: [orgId], references: [id])
  timeEntries  TimeEntry[]

  @@index([orgId, status])
}

model TimeEntry {
  id              String       @id @default(cuid())
  orgId           String
  userId          String
  projectId       String
  taskDescription String
  date            DateTime
  hours           Decimal      @db.Decimal(8, 2)
  billable        Boolean      @default(false)
  hourlyRate      Decimal?     @db.Decimal(18, 2)
  invoiced        Boolean      @default(false)
  org             Organization @relation(fields: [orgId], references: [id])
  project         Project      @relation(fields: [projectId], references: [id])
  user            User         @relation(fields: [userId], references: [id])

  @@index([orgId, date])
}

model Budget {
  id             String       @id @default(cuid())
  orgId          String
  fiscalYear     Int
  accountId      String
  monthlyAmounts Json
  account        Account      @relation(fields: [accountId], references: [id])
  org            Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, fiscalYear, accountId])
}

model AuditLogEntry {
  id         String       @id @default(cuid())
  orgId      String
  userId     String?
  action     String
  entityType String
  entityId   String
  diff       Json
  ipAddress  String?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id])
  user       User?        @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

model Attachment {
  id             String       @id @default(cuid())
  orgId          String
  entityType     String
  entityId       String
  fileUrl        String
  uploadedBy     String
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id])
  uploadedByUser User         @relation("AttachmentUploadedBy", fields: [uploadedBy], references: [id])

  @@index([orgId, entityType, entityId])
}

model Notification {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@index([orgId, userId, readAt])
}

model SavedReport {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  type         String
  config       Json
  scheduleCron String?
  recipients   String[]     @default([])
  org          Organization @relation(fields: [orgId], references: [id])
}

model Integration {
  id              String            @id @default(cuid())
  orgId           String
  provider        String
  status          IntegrationStatus @default(CONNECTED)
  configEncrypted Json
  connectedAt     DateTime          @default(now())
  org             Organization      @relation(fields: [orgId], references: [id])

  @@unique([orgId, provider])
}

model ExchangeRate {
  id           String       @id @default(cuid())
  orgId        String
  currencyCode String
  rateToBase   Decimal      @db.Decimal(18, 8)
  asOfDate     DateTime
  org          Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, currencyCode, asOfDate])
}

model WorkspaceRecord {
  id            String       @id @default(cuid())
  orgId         String
  moduleKey     String
  title         String
  subtitle      String?
  status        String?
  amountMinor   Int?
  metadata      Json?
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdByUser User?        @relation("WorkspaceRecordCreatedBy", fields: [createdBy], references: [id])
  org           Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, moduleKey, createdAt])
}

model ImportBatch {
  id               String       @id @default(cuid())
  orgId            String
  targetType       String
  fileName         String
  totalRows        Int
  successRows      Int
  failedRows       Int
  status           String
  createdRecordIds Json
  importedBy       String
  createdAt        DateTime     @default(now())
  reversedAt       DateTime?
  importedByUser   User         @relation("ImportBatchImportedBy", fields: [importedBy], references: [id])
  org              Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, targetType, createdAt])
}

