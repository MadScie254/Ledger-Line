{
  "name": "@ledgerline/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run test/**/*.integration.test.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "set OPENNEXT_CLOUDFLARE_DEV=1&& opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "set OPENNEXT_CLOUDFLARE_DEV=1&& opennextjs-cloudflare build && wrangler deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@ledgerline/db": "0.1.0",
    "@ledgerline/ledger-service": "0.1.0",
    "@ledgerline/types": "0.1.0",
    "@ledgerline/ui": "0.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.62.8",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.22",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "victory-vendor": "^36.9.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.114.0"
  }
}
